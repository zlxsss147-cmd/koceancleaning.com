---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PRODUCT_CATEGORIES } from '../../data/site';
import { getCollection } from 'astro:content';

const categoryDetails = {
  'microfiber-cleaning': {
    desc: 'Microfiber cloths, towels and wipes in woven and knitted constructions, from 200gsm terry to ultra-light 180gsm flat weave. Custom sizes, colors and edge finishing.',
    items: ['Microfiber cleaning cloths', 'Microfiber towels & chamois', 'Glass & screen cloths', 'Dusting cloths', 'Waffle & terry weaves'],
  },
  mops: {
    desc: 'Flat mops, spray mops, Kentucky mops and twist mops with microfiber and nonwoven heads. Complete mop systems or replacement heads for your existing line.',
    items: ['Flat mop systems & refills', 'Spray mops', 'Kentucky (wetten) mops', 'Twist mops', 'Mop heads & frames'],
  },
  sponges: {
    desc: 'Kitchen sponges, scrub pads and scouring sponges with cellulose, PU and nonwoven layers. Custom die-cutting, printing and packaging.',
    items: ['Cellulose kitchen sponges', 'Scrub & scouring pads', 'Non-scratch sponges', 'Dishwashing sets', 'Industrial scrubbing sponges'],
  },
  'car-cleaning': {
    desc: 'Microfiber car care towels, drying towels, wash mitts and detailing sets built for automotive professionals and detailing brands.',
    items: ['Drying towels', 'Wash mitts & pads', 'Interior detailing cloths', 'Glass & polish towels', 'Detailing kits'],
  },
  nonwovens: {
    desc: 'Spunlace, spunbond, meltblown and needle-punched nonwoven fabrics in a wide range of weights and finishes. The raw material base behind our finished products.',
    items: ['Spunlace nonwoven (hydroentangled)', 'Spunbond (PP / PET)', 'Meltblown (filtration & medical)', 'Needle-punched felt', 'Coated & laminated nonwovens'],
  },
  'wet-wipes': {
    desc: 'Wet tissue and moist wipes for home, car care and healthcare. Alcohol-free formulas, custom scent, custom dispensing formats.',
    items: ['Household wet wipes', 'Car care wipes', 'Healthcare & sanitizing wipes', 'Pet wipes', 'Custom formulations'],
  },
  'home-series': {
    desc: 'Household cleaning helpers: dusting gloves, cleaning slippers, dusters and small home-care accessories that make daily cleaning easier.',
    items: ['Dusting gloves', 'Cleaning slippers', 'Dusters & duster sets', 'Microfiber cleaning mitts', 'Home care accessories'],
  },
};

const allProducts = await getCollection('products', ({ data }) => !data.draft);
const byCat = {};
for (const p of allProducts) {
  (byCat[p.data.category] ||= []).push(p);
}
for (const k of Object.keys(byCat)) {
  byCat[k].sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
}
---

<BaseLayout title="Products" description="Microfiber cleaning cloths, mops, sponges, car cleaning, nonwovens, wet wipes and home cleaning series — OEM/ODM welcome from Kocean.">
  <section class="page-hero">
    <div class="container">
      <p class="kicker">Our Products</p>
      <h1>Cleaning products, engineered for professionals</h1>
      <p class="lead">Seven categories. One quality standard. Every item available with your brand, your size, your packaging.</p>
    </div>
  </section>

  {PRODUCT_CATEGORIES.map((cat, i) => {
    const detail = categoryDetails[cat.slug];
    const isReverse = i % 2 === 1;
    const prods = byCat[cat.slug] ?? [];
    return (
      <section class:list={['section', 'cat-block', { 'cat-block--reverse': isReverse }]} id={cat.slug}>
        <div class="container cat-inner">
          <div class="cat-left">
            <div class="cat-media">
              <img src={cat.image} alt={cat.title} loading="lazy" />
            </div>
            <span class="cat-num">{String(i + 1).padStart(2, '0')}</span>
            <h2>{cat.title}</h2>
            <p class="cat-desc">{detail.desc}</p>
          </div>
          <div class="cat-right">
            <ul class="cat-items">
              {detail.items.map((item) => (
                <li>{item}</li>
              ))}
              <li class="cat-cta">
                <a href="/contact/" class="btn btn--ghost">Request details →</a>
              </li>
            </ul>
          </div>
        </div>

        {prods.length > 0 && (
          <div class="container">
            <div class="cat-products">
              {prods.map((p) => (
                <a href={`/products/${p.slug}/`} class="card prod-card">
                  <div class="prod-thumb">
                    <img src={p.data.images[0]} alt={p.data.title} loading="lazy" />
                  </div>
                  <div class="prod-body">
                    <span class="prod-sku">{p.data.sku}</span>
                    <h3>{p.data.title}</h3>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </section>
    );
  })}

  <section class="section cta">
    <div class="container cta-box">
      <div>
        <h2>Need something custom?</h2>
        <p>Tell us the product, the spec and the quantity — we'll come back with a quote and a timeline.</p>
      </div>
      <a href="/contact/" class="btn btn--primary">Get a Quote →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(180deg, #f4faf9 0%, #ffffff 100%);
    padding: 68px 0 56px;
    border-bottom: 1px solid var(--line);
  }
  .page-hero .kicker {
    color: var(--orange-500);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.82rem;
    margin-bottom: 14px;
  }
  .page-hero h1 {
    font-size: clamp(1.9rem, 4vw, 2.7rem);
    margin-bottom: 14px;
  }
  .page-hero .lead {
    color: var(--ink-soft);
    font-size: 1.08rem;
    max-width: 640px;
  }

  .cat-block {
    scroll-margin-top: 90px;
    padding: 56px 0;
  }
  .cat-block:nth-child(even) {
    background: var(--bg-soft);
  }
  .cat-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
  }

  .cat-media {
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    margin-bottom: 22px;
  }
  .cat-media img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  .cat-num {
    display: block;
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--orange-500);
    letter-spacing: 0.14em;
    margin-bottom: 10px;
  }
  .cat-left h2 {
    font-size: 1.6rem;
    margin-bottom: 12px;
  }
  .cat-desc {
    color: var(--ink-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .cat-right {
    padding-top: 6px;
  }
  .cat-items {
    list-style: none;
    display: grid;
    gap: 12px;
  }
  .cat-items li {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px 18px;
    font-size: 0.95rem;
    color: var(--ink-soft);
    box-shadow: var(--shadow-sm);
  }
  .cat-block:nth-child(even) .cat-items li {
    background: #fff;
  }
  .cat-items .cat-cta {
    border: none;
    background: transparent;
    box-shadow: none;
    padding: 8px 0;
  }

  /* Product cards per category */
  .cat-products {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 40px;
  }
  .prod-card {
    color: var(--ink);
    display: flex;
    flex-direction: column;
  }
  .prod-card:hover { color: var(--ink); }
  .prod-thumb {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-bottom: 1px solid var(--line);
    background: var(--bg-soft);
  }
  .prod-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }
  .prod-card:hover .prod-thumb img { transform: scale(1.05); }
  .prod-body { padding: 14px 16px 18px; }
  .prod-sku {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--orange-500);
    margin-bottom: 4px;
  }
  .prod-body h3 { font-size: 0.98rem; line-height: 1.35; }

  .cta-box {
    background: linear-gradient(120deg, var(--teal-800), var(--teal-700));
    border-radius: var(--radius);
    padding: 44px 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    color: #fff;
    box-shadow: var(--shadow-lg);
  }
  .cta-box h2 { color: #fff; font-size: 1.6rem; margin-bottom: 8px; }
  .cta-box p { color: #c4d8d5; }

  @media (min-width: 769px) {
    .cat-block--reverse .cat-left { order: 2; }
    .cat-block--reverse .cat-right { order: 1; }
  }

  @media (max-width: 980px) {
    .cat-products { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 768px) {
    .cat-inner { grid-template-columns: 1fr; gap: 32px; }
    .cat-block { padding: 42px 0; }
    .cat-products { grid-template-columns: repeat(2, 1fr); }
    .cta-box { flex-direction: column; text-align: center; }
  }
  @media (max-width: 480px) {
    .cat-products { grid-template-columns: 1fr; }
  }
</style>
