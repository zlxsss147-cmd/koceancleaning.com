---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { COMPANY } from '../../data/site';
---

<BaseLayout title="Contact Us" description="Contact Kocean for quotes, samples and OEM projects. We reply within 24 hours on business days.">
  <section class="page-hero">
    <div class="container">
      <p class="kicker">Contact</p>
      <h1>Tell us what you need to build</h1>
      <p class="lead">Quotes, samples, OEM projects — send us the details and we'll respond within 24 hours on business days.</p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <form id="contact-form" class="contact-form" method="POST" action="https://formspree.io/f/maeywbey">
        <input type="hidden" name="_subject" value="New B2B inquiry from Kocean website" />
        <input type="hidden" name="_next" value="https://koceancleaning.com/contact/?sent=1" />
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true" />
        <div class="form-row">
          <div class="form-field">
            <label for="name">Name *</label>
            <input type="text" id="name" name="name" required placeholder="Your name" />
          </div>
          <div class="form-field">
            <label for="company">Company</label>
            <input type="text" id="company" name="company" placeholder="Company name" />
          </div>
        </div>
        <div class="form-row">
          <div class="form-field">
            <label for="email">Email *</label>
            <input type="email" id="email" name="email" required placeholder="you@company.com" />
          </div>
          <div class="form-field">
            <label for="country">Country</label>
            <input type="text" id="country" name="country" placeholder="Your country" />
          </div>
        </div>
        <div class="form-field">
          <label for="subject">I'm interested in</label>
          <select id="subject" name="subject">
            <option>Microfiber cleaning</option>
            <option>Mops</option>
            <option>Sponges &amp; scrubbers</option>
            <option>Car cleaning</option>
            <option>Nonwovens</option>
            <option>Wet wipes</option>
            <option>Home series</option>
            <option>OEM / ODM project</option>
            <option>Other</option>
          </select>
        </div>
        <div class="form-field">
          <label for="message">Message *</label>
          <textarea id="message" name="message" rows="5" required placeholder="Product, specification, target quantity, target price..."></textarea>
        </div>
        <button type="submit" class="btn btn--primary">Send Inquiry →</button>
        <p class="form-note">This form is for B2B inquiries only. We don't sell to individual consumers.</p>
        <p id="form-success" class="form-success" hidden>
          ✅ Thank you! Your inquiry has been sent. We'll get back to you within 24 hours on business days.
        </p>
      </form>

      <aside class="contact-info">
        <h3>Direct contact</h3>
        <ul>
          <li>
            <span class="ci-label">Email</span>
            <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>
          </li>
          <li>
            <span class="ci-label">Phone</span>
            <a href={`tel:${COMPANY.phone.replace(/[^+\d]/g, '')}`}>{COMPANY.phone}</a>
          </li>
          <li>
            <span class="ci-label">WhatsApp</span>
            <a href={`https://wa.me/${COMPANY.whatsapp.replace(/[^\d]/g, '')}`} target="_blank" rel="noopener">{COMPANY.whatsapp}</a>
          </li>
          <li>
            <span class="ci-label">Address</span>
            <span>{COMPANY.address}</span>
          </li>
        </ul>
        <div class="contact-response">
          <h4>Typical response time</h4>
          <p>&lt; 24 hours on business days</p>
        </div>
        <div class="contact-response">
          <h4>Prefer samples first?</h4>
          <p>Tell us your address and which products you'd like to evaluate — we'll arrange it.</p>
        </div>
      </aside>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form');
    const success = document.getElementById('form-success');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]');
      const original = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          form.reset();
          if (success) success.hidden = false;
          success?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          throw new Error('Formspree error');
        }
      } catch (err) {
        // Fallback: let the browser do a native POST to Formspree.
        form.submit();
      } finally {
        btn.disabled = false;
        btn.textContent = original;
      }
    });
  </script>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(180deg, #f4faf9 0%, #ffffff 100%);
    padding: 68px 0 56px;
    border-bottom: 1px solid var(--line);
  }
  .page-hero .kicker {
    color: var(--orange-500);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.82rem;
    margin-bottom: 14px;
  }
  .page-hero h1 { font-size: clamp(1.9rem, 4vw, 2.7rem); margin-bottom: 14px; }
  .page-hero .lead { color: var(--ink-soft); font-size: 1.08rem; max-width: 640px; }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 48px;
    align-items: start;
  }
  .contact-form {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 36px;
    box-shadow: var(--shadow-sm);
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .form-field {
    margin-bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .form-field label {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .form-field input,
  .form-field select,
  .form-field textarea {
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px 14px;
    font-size: 0.96rem;
    font-family: inherit;
    color: var(--ink);
    background: #fff;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .form-field input:focus,
  .form-field select:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: var(--teal-500);
    box-shadow: 0 0 0 3px rgba(31, 138, 131, 0.14);
  }
  .form-note {
    margin-top: 14px;
    font-size: 0.84rem;
    color: var(--ink-muted);
  }
  .form-success {
    margin-top: 16px;
    padding: 14px 16px;
    border-radius: 10px;
    background: var(--teal-50);
    border: 1px solid var(--teal-100);
    color: var(--teal-800);
    font-size: 0.92rem;
  }

  .contact-info {
    background: var(--teal-50);
    border: 1px solid var(--teal-100);
    border-radius: var(--radius);
    padding: 30px 28px;
  }
  .contact-info h3 {
    color: var(--teal-800);
    font-size: 1.1rem;
    margin-bottom: 20px;
  }
  .contact-info ul { list-style: none; }
  .contact-info li {
    padding: 13px 0;
    border-bottom: 1px solid var(--teal-100);
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .ci-label {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--teal-600);
  }
  .contact-info li a, .contact-info li span {
    color: var(--ink-soft);
    font-size: 0.97rem;
  }
  .contact-response {
    margin-top: 22px;
    padding: 16px;
    background: #fff;
    border-radius: 10px;
    border: 1px solid var(--line);
  }
  .contact-response h4 {
    font-size: 0.92rem;
    color: var(--teal-800);
    margin-bottom: 4px;
  }
  .contact-response p {
    font-size: 0.9rem;
    color: var(--ink-muted);
  }

  @media (max-width: 768px) {
    .contact-grid { grid-template-columns: 1fr; }
    .form-row { grid-template-columns: 1fr; }
  }
</style>
