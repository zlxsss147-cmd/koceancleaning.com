---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const { title, description, pubDate, updatedDate, category, tags } = post.data;

const related = (await getCollection('blog', ({ data }) => !data.draft && data.category === category))
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title={title} description={description}>
  <article class="article">
    <div class="container article-inner">
      <header class="article-head">
        <a href="/blog/" class="back-link">← Knowledge Hub</a>
        <span class="post-cat">{category}</span>
        <h1>{title}</h1>
        <p class="article-desc">{description}</p>
        <div class="article-meta">
          <time datetime={pubDate.toISOString()}>
            {pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
          </time>
          {updatedDate && (
            <span> · Updated {updatedDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
          )}
        </div>
        {tags && tags.length > 0 && (
          <div class="article-tags">
            {tags.map((t) => <span class="tag">#{t}</span>)}
          </div>
        )}
      </header>

      <div class="article-body">
        <Content />
      </div>

      <footer class="article-foot">
        <div class="cta-box">
          <div>
            <h2>Need this product?</h2>
            <p>Talk to a Kocean export specialist about specifications, samples and pricing.</p>
          </div>
          <a href="/contact/" class="btn btn--primary">Get a Quote →</a>
        </div>

        {related.length > 0 && (
          <div class="related">
            <h3>More in {category}</h3>
            <div class="related-grid">
              {related.map((r) => (
                <a href={`/blog/${r.slug}/`} class="card related-card">
                  <h4>{r.data.title}</h4>
                  <p>{r.data.description}</p>
                </a>
              ))}
            </div>
          </div>
        )}
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    padding: 56px 0 72px;
  }
  .article-inner {
    max-width: 780px;
  }
  .article-head {
    margin-bottom: 40px;
  }
  .back-link {
    display: inline-block;
    margin-bottom: 20px;
    color: var(--ink-muted);
    font-size: 0.92rem;
    font-weight: 500;
  }
  .back-link:hover { color: var(--teal-700); }
  .post-cat {
    display: inline-block;
    background: var(--teal-50);
    color: var(--teal-700);
    font-weight: 600;
    font-size: 0.82rem;
    padding: 5px 12px;
    border-radius: 999px;
    margin-bottom: 16px;
  }
  .article-head h1 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    line-height: 1.25;
    margin-bottom: 16px;
  }
  .article-desc {
    color: var(--ink-soft);
    font-size: 1.12rem;
    margin-bottom: 16px;
  }
  .article-meta {
    color: var(--ink-muted);
    font-size: 0.9rem;
  }
  .article-tags {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tag {
    background: var(--bg-soft);
    border: 1px solid var(--line);
    color: var(--ink-muted);
    font-size: 0.8rem;
    padding: 4px 10px;
    border-radius: 999px;
  }

  .article-body {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--ink);
  }
  .article-body h2 {
    font-size: 1.45rem;
    margin: 40px 0 16px;
  }
  .article-body img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    margin: 28px 0 8px;
  }
  .article-body img + em {
    display: block;
    color: var(--ink-muted);
    font-size: 0.85rem;
    font-style: normal;
    text-align: center;
    margin: 0 0 28px;
  }
  .article-body h3 {
    font-size: 1.18rem;
    margin: 28px 0 12px;
    color: var(--ink-soft);
  }
  .article-body p {
    margin-bottom: 18px;
  }
  .article-body ul, .article-body ol {
    margin: 0 0 18px 24px;
  }
  .article-body li {
    margin-bottom: 8px;
  }
  .article-body a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .article-body blockquote {
    border-left: 4px solid var(--teal-500);
    padding: 14px 20px;
    margin: 24px 0;
    background: var(--teal-50);
    border-radius: 0 10px 10px 0;
    color: var(--ink-soft);
  }
  .article-body pre.spec-sheet {
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-left: 4px solid var(--teal-500);
    border-radius: 0 10px 10px 0;
    padding: 18px 22px;
    margin: 24px 0;
    font-size: 0.9rem;
    line-height: 1.7;
    overflow-x: auto;
    color: var(--ink-soft);
    white-space: pre;
  }
  .article-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0;
    font-size: 0.95rem;
  }
  .article-body th, .article-body td {
    border: 1px solid var(--line);
    padding: 10px 14px;
    text-align: left;
  }
  .article-body th {
    background: var(--bg-soft);
    font-weight: 600;
  }

  .article-foot {
    margin-top: 56px;
  }
  .cta-box {
    background: linear-gradient(120deg, var(--teal-800), var(--teal-700));
    border-radius: var(--radius);
    padding: 36px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    color: #fff;
    box-shadow: var(--shadow-md);
  }
  .cta-box h2 { color: #fff; font-size: 1.4rem; margin-bottom: 6px; }
  .cta-box p { color: #c4d8d5; font-size: 0.95rem; }

  .related {
    margin-top: 48px;
  }
  .related h3 {
    font-size: 1.1rem;
    margin-bottom: 18px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .related-card {
    padding: 20px;
    color: var(--ink);
  }
  .related-card:hover { color: var(--ink); }
  .related-card h4 {
    font-size: 0.98rem;
    line-height: 1.4;
    margin-bottom: 8px;
  }
  .related-card p {
    font-size: 0.85rem;
    color: var(--ink-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .cta-box { flex-direction: column; text-align: center; }
    .related-grid { grid-template-columns: 1fr; }
  }
</style>
