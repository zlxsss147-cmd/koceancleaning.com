---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { BLOG_CATEGORIES, categorySlug } from '../../../utils/blogCategories';

export async function getStaticPaths() {
  return BLOG_CATEGORIES.map((category) => ({
    params: { category: categorySlug(category) },
    props: { category },
  }));
}

const { category } = Astro.props;

const posts = (
  await getCollection('blog', ({ data }) => !data.draft && data.category === category)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title={`${category} — Knowledge Hub`}
  description={`Articles about ${category} — material science, product selection and sourcing guidance for professional cleaning products.`}
>
  <section class="page-hero">
    <div class="container">
      <p class="kicker">Knowledge Hub · {category}</p>
      <h1>{category}</h1>
      <p class="lead">
        {category === 'Nonwoven Materials'
          ? 'How nonwoven fabrics are made, how they differ, and which one fits your cleaning product.'
          : category === 'Buying Guides'
            ? 'Practical checklists for choosing and sourcing microfiber and nonwoven cleaning products.'
            : category === 'Applications'
              ? 'Where different cleaning materials work best — from homes to industrial settings.'
              : category === 'OEM & Quality'
                ? 'Manufacturing, quality control and private-label sourcing essentials for brands and distributors.'
              : 'Safety standards, certifications and sustainability for textile and cleaning products.'}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="filter-bar">
        <a
          href="/blog/"
          class="filter-chip"
        >All</a>
        {BLOG_CATEGORIES.map((c) => (
          <a
            href={`/blog/category/${categorySlug(c)}/`}
            class:list={['filter-chip', { 'is-active': c === category }]}
          >{c}</a>
        ))}
      </div>

      {posts.length > 0 ? (
        <div class="post-grid">
          {posts.map((post) => (
            <a href={`/blog/${post.slug}/`} class="card post-card">
              <div class="post-meta">
                <span class="post-cat">{post.data.category}</span>
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </time>
              </div>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <span class="post-link">Read more →</span>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty">No articles in this category yet. Check back soon.</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(180deg, #f4faf9 0%, #ffffff 100%);
    padding: 68px 0 56px;
    border-bottom: 1px solid var(--line);
  }
  .page-hero .kicker {
    color: var(--orange-500);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.82rem;
    margin-bottom: 14px;
  }
  .page-hero h1 { font-size: clamp(1.9rem, 4vw, 2.7rem); margin-bottom: 14px; }
  .page-hero .lead { color: var(--ink-soft); font-size: 1.08rem; max-width: 640px; }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 36px;
  }
  .filter-chip {
    padding: 8px 18px;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink-soft);
    background: #fff;
  }
  .filter-chip:hover {
    border-color: var(--teal-500);
    color: var(--teal-700);
  }
  .filter-chip.is-active {
    background: var(--teal-800);
    border-color: var(--teal-800);
    color: #fff;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .post-card {
    padding: 26px;
    color: var(--ink);
  }
  .post-card:hover { color: var(--ink); }
  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    font-size: 0.8rem;
  }
  .post-cat {
    background: var(--teal-50);
    color: var(--teal-700);
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 999px;
  }
  .post-meta time { color: var(--ink-muted); }
  .post-card h2 {
    font-size: 1.14rem;
    margin-bottom: 10px;
    line-height: 1.35;
  }
  .post-card p {
    color: var(--ink-muted);
    font-size: 0.92rem;
    margin-bottom: 16px;
  }
  .post-link {
    color: var(--teal-700);
    font-weight: 600;
    font-size: 0.9rem;
  }
  .empty {
    text-align: center;
    color: var(--ink-muted);
    padding: 60px 0;
  }

  @media (max-width: 900px) {
    .post-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .post-grid { grid-template-columns: 1fr; }
  }
</style>
