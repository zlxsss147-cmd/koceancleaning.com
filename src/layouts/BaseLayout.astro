---
import { SITE, COMPANY, NAV } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const pageDesc = description ?? SITE.description;
const pageImage = image ?? SITE.ogImage;
---

<!DOCTYPE html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="keywords" content={SITE.keywords} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kocean Cleaning" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image" content={new URL(pageImage, SITE.url)} />
    <meta property="og:url" content={new URL(Astro.url.pathname, SITE.url)} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={new URL(pageImage, SITE.url)} />

    <link rel="canonical" href={new URL(Astro.url.pathname, SITE.url)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🧽</text></svg>"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand">
          <img
            src="/images/logo.png"
            alt="Kocean Cleaning Products"
            width="91"
            height="52"
            class="brand-logo"
          />
        </a>
        <nav class="site-nav" aria-label="Main navigation">
          {NAV.map((item) => (
            <a href={item.href} class:list={{ 'is-active': Astro.url.pathname === item.href }}>{item.label}</a>
          ))}
        </nav>
        <a href="/contact/" class="btn btn--primary nav-cta">Get a Quote</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <strong>KOCEAN</strong>
          <p>
            {COMPANY.legalName} · {COMPANY.group}
            <br />
            {COMPANY.address}
          </p>
          <p class="footer-since">Est. {COMPANY.since} · Exporting to {COMPANY.exportCountries} countries</p>
        </div>
        <div class="footer-col">
          <h4>Products</h4>
          <ul>
            <li><a href="/products/#microfiber-cleaning">Microfiber Cleaning</a></li>
            <li><a href="/products/#mops">Mops</a></li>
            <li><a href="/products/#sponges">Sponges &amp; Scrubbers</a></li>
            <li><a href="/products/#car-cleaning">Car Cleaning</a></li>
            <li><a href="/products/#nonwovens">Nonwovens</a></li>
            <li><a href="/products/#wet-wipes">Wet Wipes</a></li>
            <li><a href="/products/#home-series">Home Series</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Company</h4>
          <ul>
            <li><a href="/about/">About Us</a></li>
            <li><a href="/oem/">OEM / ODM</a></li>
            <li><a href="/blog/">Knowledge Hub</a></li>
            <li><a href="/contact/">Contact</a></li>
          </ul>
        </div>
        <div class="footer-col footer-contact">
          <h4>Contact</h4>
          <p><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></p>
          <p><a href={`tel:${COMPANY.phone.replace(/[^+\d]/g, '')}`}>{COMPANY.phone}</a></p>
          <p><a href={`https://wa.me/${COMPANY.whatsapp.replace(/[^\d]/g, '')}`} target="_blank" rel="noopener">WhatsApp</a></p>
          <p><a class="footer-linkedin" href={COMPANY.linkedin} target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
            LinkedIn
          </a></p>
        </div>
      </div>
      <div class="container footer-bottom">
        <p>© {new Date().getFullYear()} {COMPANY.legalName}. All rights reserved.</p>
        <p class="footer-bottom-right">
          <a class="footer-linkedin" href={COMPANY.linkedin} target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
            Follow us on LinkedIn
          </a>
          <span class="footer-note">A member of {COMPANY.group}</span>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 74px;
  }
  .brand {
    display: flex;
    align-items: center;
  }
  .brand-logo {
    height: 52px;
    width: auto;
    display: block;
  }
  .site-nav {
    display: flex;
    gap: 28px;
    font-weight: 500;
    font-size: 0.96rem;
  }
  .site-nav a {
    color: var(--ink-soft);
    padding: 6px 0;
    border-bottom: 2px solid transparent;
  }
  .site-nav a:hover {
    color: var(--teal-700);
  }
  .site-nav a.is-active {
    color: var(--teal-800);
    border-bottom-color: var(--orange-500);
  }
  .nav-cta {
    padding: 10px 22px;
    font-size: 0.92rem;
  }

  .site-footer {
    background: var(--teal-900);
    color: #c4d8d5;
    padding: 60px 0 24px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    gap: 40px;
    margin-bottom: 40px;
  }
  .footer-brand strong {
    font-size: 1.2rem;
    letter-spacing: 0.14em;
    color: #fff;
  }
  .footer-brand p {
    margin-top: 12px;
    font-size: 0.92rem;
    color: #9fb9b5;
  }
  .footer-since {
    color: #7fa09b !important;
  }
  .footer-col h4 {
    color: #fff;
    font-size: 0.95rem;
    margin-bottom: 14px;
  }
  .footer-col ul {
    list-style: none;
  }
  .footer-col li {
    margin-bottom: 10px;
  }
  .footer-col a {
    color: #c4d8d5;
    font-size: 0.92rem;
  }
  .footer-col a:hover {
    color: #fff;
  }
  .footer-linkedin {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .footer-linkedin svg {
    flex: none;
  }
  .footer-linkedin:hover {
    color: #5fb3e8;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: 20px;
    font-size: 0.85rem;
    color: #7fa09b;
  }
  .footer-note { color: #6d918c; }
  .footer-bottom-right {
    display: inline-flex;
    align-items: center;
    gap: 18px;
  }
  .footer-bottom-right .footer-linkedin { color: #c4d8d5; }

  @media (max-width: 900px) {
    .site-nav { display: none; }
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
